# Copy to .env for local development. Never commit .env.

# --- Deployment mode ---
# local (default) | production
# TASKS_BRIDGE_DEPLOYMENT=local

# --- MCP HTTP server ---
# HOST=127.0.0.1
# PORT=8000
# MCP_PATH=/mcp

# --- Public hostname (production / Railway) ---
# Set automatically on Railway via RAILWAY_PUBLIC_DOMAIN, or override:
# MCP_PUBLIC_HOST=your-app.up.railway.app

# --- Inbound MCP authentication (production / public HTTPS) ---
# Required when TASKS_BRIDGE_DEPLOYMENT=production or on Railway.
# ChatGPT and other clients must send: Authorization: Bearer <token>
# MCP_API_TOKEN=

# Optional HTTP hardening overrides:
# MCP_RATE_LIMIT_REQUESTS=60
# MCP_RATE_LIMIT_WINDOW_SECONDS=60
# MCP_MAX_REQUEST_BYTES=1048576

# Railway preview safety — production env name and preview override:
# TASKS_BRIDGE_PRODUCTION_ENV=production
# ALLOW_PREVIEW_SECRETS=0

# --- Google OAuth (local: use credentials.json + token.json instead) ---
# Production / Railway: required (no browser flow on server)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Or inject full authorized-user JSON:
# GOOGLE_TOKEN_JSON=

# Optional file path overrides (local):
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json

# --- OpenAI Secure MCP Tunnel (local ChatGPT only) ---
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
TUNNEL_CLIENT_PROFILE=tasks-bridge

# --- Cursor stdio mode ---
# MCP_TRANSPORT=stdio
