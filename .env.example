# Copy to .env for local development. Never commit .env.
# Comments: use # at the start of a line, or whitespace before # on the same line.

# --- Deployment mode ---
# local (default) | production
# TASKS_BRIDGE_DEPLOYMENT=local

# --- MCP HTTP server ---
# HOST=127.0.0.1
# PORT=8000
# MCP_PATH=/mcp

# --- Public hostname (production / Railway) ---
# Set automatically on Railway via RAILWAY_PUBLIC_DOMAIN, or override:
# MCP_PUBLIC_HOST=your-app.up.railway.app

# --- Inbound MCP authentication ---
# Exactly one mode: none (local default) | static | oauth (stub)
# MCP_AUTH_MODE=none
#
# When MCP_AUTH_MODE=static, MCP_API_TOKEN is required (local and Railway).
# Clients send: Authorization: Bearer <token>
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_API_TOKEN=

# Optional HTTP hardening overrides:
# MCP_RATE_LIMIT_REQUESTS=60
# MCP_RATE_LIMIT_WINDOW_SECONDS=60
# MCP_MAX_REQUEST_BYTES=1048576

# Railway preview safety — production env name and preview override:
# TASKS_BRIDGE_PRODUCTION_ENV=production
# ALLOW_PREVIEW_SECRETS=0

# --- Google OAuth (local: use credentials.json + token.json instead) ---
# Production / Railway: required (no browser flow on server)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Or inject full authorized-user JSON:
# GOOGLE_TOKEN_JSON=

# Optional file path overrides (local):
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json

# --- OpenAI Secure MCP Tunnel (local ChatGPT only) ---
# ChatGPT tunnel expects MCP_AUTH_MODE=none on localhost (tunnel does not send bearer).
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
TUNNEL_CLIENT_PROFILE=tasks-bridge

# --- macOS Terminal window layout (--windows) ---
# TASKS_BRIDGE_WINDOW_WIDTH=440
# TASKS_BRIDGE_WINDOW_HEIGHT=260
# TASKS_BRIDGE_WINDOW_X=20
# TASKS_BRIDGE_WINDOW_Y=40
# TASKS_BRIDGE_WINDOW_GAP=8

# --- Cursor stdio mode ---
# MCP_TRANSPORT=stdio
